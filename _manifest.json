{
  "manifest_version": 2,
  "version": "0.2.0",
  "id": "github.ZhaoCang-QWQ.model-scheduler",
  "name": "时段模型调度",
  "description": "按时段自动切换回复模型：自定义多条「时间区间 → 模型」规则，命中时段用指定模型（如 DeepSeek 错峰半价时段），不命中则不干预。通用调度器，不绑定任何模型厂商。",
  "author": {"name": "昭沧QWQ", "url": "https://github.com/ZhaoCang-QWQ"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/ZhaoCang-QWQ/model-scheduler", "homepage": "https://github.com/ZhaoCang-QWQ/model-scheduler"},
  "host_application": {"min_version": "1.2.0", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.5.0", "max_version": "2.99.99"},
  "capabilities": [],
  "plugin_type": "extension",
  "display": {"icon": {"type": "emoji", "value": "⏰"}},
  "changelog": "CHANGELOG.md",
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
